{
  "info": {
    "_postman_id": "3b3c3626-22f5-4d56-b4fe-23db6f798001",
    "name": "金影子-后端测试模板",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "TC-AUTH-LOGIN-模板",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expectedHttp = Number(pm.iterationData.get('预期HTTP状态') || 200);",
                  "const expectedCode = String(pm.iterationData.get('预期业务码') || '200');",
                  "const expectedMsg = String(pm.iterationData.get('预期message关键字') || '');",
                  "pm.test('HTTP状态正确', function () {",
                  "  pm.response.to.have.status(expectedHttp);",
                  "});",
                  "let body = {};",
                  "try {",
                  "  body = pm.response.json();",
                  "} catch (e) {",
                  "  pm.test('响应必须是JSON', function () {",
                  "    pm.expect.fail('响应不是JSON');",
                  "  });",
                  "}",
                  "pm.test('响应结构正确', function () {",
                  "  pm.expect(body).to.have.property('code');",
                  "  pm.expect(body).to.have.property('message');",
                  "  pm.expect(body).to.have.property('data');",
                  "});",
                  "pm.test('业务码正确', function () {",
                  "  pm.expect(String(body.code)).to.eql(expectedCode);",
                  "});",
                  "if (expectedMsg) {",
                  "  pm.test('message关键字正确', function () {",
                  "    pm.expect(String(body.message || '')).to.include(expectedMsg);",
                  "  });",
                  "}",
                  "if (String(body.code) === '200' && body.data && body.data.token) {",
                  "  pm.environment.set('token', body.data.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001/api"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    }
  ]
}
