{
  "name": "jinyingzi-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend/app",
    "frontend/admin",
    "backend"
  ],
  "scripts": {
    "dev:app": "npm --prefix frontend/app run dev",
    "dev:admin": "npm --prefix frontend/admin run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:mock": "npm --prefix frontend/app run mock",
    "build:app": "npm --prefix frontend/app run build",
    "build:admin": "npm --prefix frontend/admin run build",
    "build:backend": "npm --prefix backend run build",
    "test:app": "npm --prefix frontend/app run test:run",
    "test:backend": "npm --prefix backend run test"
  }
}
