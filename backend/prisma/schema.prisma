generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  FROZEN
  DISABLED
}

enum RealNameStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  COMPLETED
  MUTED
}

enum RechargeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

enum AssetChangeType {
  RECHARGE
  WITHDRAW_FREEZE
  WITHDRAW_RELEASE
  WITHDRAW_COMPLETE
  TRADE_BUY
  TRADE_SELL
  MANUAL_ADJUST
  PAYMENT_OUT
  PAYMENT_IN
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LeaderboardRule {
  GOLD_HOLDING_GRAMS
  TOTAL_ASSET
}

enum LeaderboardJobStatus {
  REBUILDING
  SYNCED
  FAILED
}

enum OperationIdempotencyStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ReportJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ReportArtifactFormat {
  CSV
  EXCEL
  JSON
}

enum PaymentScene {
  USER
  MERCHANT
}

enum PaymentStatus {
  COMPLETED
  FAILED
}

model User {
  id               String          @id @default(cuid())
  uid              String          @unique
  username         String          @unique
  passwordHash     String
  nickname         String?
  phone            String?         @unique
  email            String?         @unique
  status           UserStatus      @default(ACTIVE)
  realNameStatus   RealNameStatus  @default(PENDING)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  asset            Asset?
  rechargeOrders   RechargeOrder[]
  withdrawalOrders WithdrawalOrder[]
  tradeOrders      TradeOrder[]
  paymentProfile   PaymentProfile?
  paymentOrdersSent PaymentOrder[] @relation("payment_payer")
  paymentOrdersReceived PaymentOrder[] @relation("payment_payee")
  auditLogs        AuditLog[]
}

model AdminUser {
  id             String                @id @default(cuid())
  username       String                @unique
  passwordHash   String
  displayName    String?
  status         UserStatus            @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  roles          AdminUserRole[]
  auditLogs      AdminOperationLog[]

  @@index([status, updatedAt])
}

model AdminRole {
  id             String                @id @default(cuid())
  code           String                @unique
  name           String
  description    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  users          AdminUserRole[]
  permissions    AdminRolePermission[]
}

model AdminPermission {
  id             String                @id @default(cuid())
  code           String                @unique
  name           String
  description    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  roles          AdminRolePermission[]
}

model AdminUserRole {
  id             String    @id @default(cuid())
  adminUserId    String
  roleId         String
  createdAt      DateTime  @default(now())
  adminUser      AdminUser @relation(fields: [adminUserId], references: [id])
  role           AdminRole @relation(fields: [roleId], references: [id])

  @@unique([adminUserId, roleId])
  @@index([adminUserId])
  @@index([roleId])
}

model AdminRolePermission {
  id             String          @id @default(cuid())
  roleId         String
  permissionId   String
  createdAt      DateTime        @default(now())
  role           AdminRole       @relation(fields: [roleId], references: [id])
  permission     AdminPermission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model AdminOperationLog {
  id             String     @id @default(cuid())
  adminUserId    String?
  module         String
  action         String
  traceId        String
  payload        Json
  createdAt      DateTime   @default(now())
  adminUser      AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([module, createdAt])
  @@index([traceId])
  @@index([traceId, createdAt])
}

model Asset {
  id                   String        @id @default(cuid())
  userId               String        @unique
  tentativeAsset       Decimal       @db.Decimal(18, 2)
  cashAsset            Decimal       @db.Decimal(18, 2)
  appreciationIncome   Decimal       @db.Decimal(18, 2)
  goldHoldingGrams     Decimal       @db.Decimal(18, 4)
  withdrawFrozenAmount Decimal       @db.Decimal(18, 2)
  totalAsset           Decimal       @db.Decimal(18, 2)
  updatedAt            DateTime      @updatedAt
  user                 User          @relation(fields: [userId], references: [id])
  ledgerEntries        LedgerEntry[]

  @@index([updatedAt])
}

model PaymentProfile {
  id          String   @id @default(cuid())
  userId       String   @unique
  qrPayload    String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model PaymentOrder {
  id             String        @id @default(cuid())
  traceId        String        @unique
  payerId        String
  payeeId        String
  amount         Decimal       @db.Decimal(18, 2)
  scene          PaymentScene
  status         PaymentStatus @default(COMPLETED)
  remark         String?
  idempotencyKey String        @unique
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  payer          User          @relation("payment_payer", fields: [payerId], references: [id])
  payee          User          @relation("payment_payee", fields: [payeeId], references: [id])
  hashRecords    HashRecord[]

  @@index([payerId, createdAt])
  @@index([payeeId, createdAt])
  @@index([status, createdAt])
}

model RechargeOrder {
  id               String         @id @default(cuid())
  userId           String
  channel          String
  amount           Decimal        @db.Decimal(18, 2)
  status           RechargeStatus @default(PENDING)
  traceId          String         @unique
  channelReference String?
  autoSettleAt     DateTime
  settledAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id])
  hashRecords      HashRecord[]
}

model WithdrawalOrder {
  id                String           @id @default(cuid())
  userId            String
  amount            Decimal          @db.Decimal(18, 2)
  status            WithdrawalStatus @default(PENDING)
  queueNo           Int              @unique @default(autoincrement())
  traceId           String           @unique
  submittedAt       DateTime         @default(now())
  reviewedAt        DateTime?
  completedAt       DateTime?
  payeeName         String?
  wechatReceiptUrl  String?
  alipayReceiptUrl  String?
  bankName          String?
  bankAccountNo     String?
  bankAccountHolder String?
  reviewerId        String?
  isVoiceMuted      Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id])
  hashRecords       HashRecord[]

  @@index([status, submittedAt])
}

model TradeOrder {
  id            String       @id @default(cuid())
  userId        String
  side          TradeSide
  status        TradeStatus  @default(OPEN)
  assetCode     String
  price         Decimal      @db.Decimal(18, 2)
  quantityGrams Decimal      @db.Decimal(18, 4)
  filledGrams   Decimal      @db.Decimal(18, 4) @default(0)
  traceId       String       @unique
  submittedAt   DateTime     @default(now())
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id])
  buyMatches    TradeMatch[] @relation("buyOrder")
  sellMatches   TradeMatch[] @relation("sellOrder")
  hashRecords   HashRecord[]

  @@index([userId, submittedAt])
  @@index([status, submittedAt])
}

model TradeMatch {
  id           String     @id @default(cuid())
  buyOrderId   String
  sellOrderId  String
  matchedPrice Decimal    @db.Decimal(18, 2)
  matchedGrams Decimal    @db.Decimal(18, 4)
  traceId      String     @unique
  matchedAt    DateTime   @default(now())
  buyOrder     TradeOrder @relation("buyOrder", fields: [buyOrderId], references: [id])
  sellOrder    TradeOrder @relation("sellOrder", fields: [sellOrderId], references: [id])
}

model LedgerEntry {
  id           String          @id @default(cuid())
  assetId       String
  userId        String
  changeType    AssetChangeType
  amount        Decimal         @db.Decimal(18, 2)
  traceId       String
  balanceAfter  Decimal         @db.Decimal(18, 2)
  referenceType String
  referenceId   String
  createdAt     DateTime        @default(now())
  asset         Asset           @relation(fields: [assetId], references: [id])

  @@index([userId, createdAt])
  @@index([traceId])
  @@index([traceId, createdAt])
  @@index([referenceType, referenceId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  actorType String
  actorId   String?
  module    String
  action    String
  traceId   String
  payload   Json
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([module, createdAt])
  @@index([traceId])
  @@index([traceId, createdAt])
}

model HashRecord {
  id                String           @id @default(cuid())
  referenceType     String
  referenceId       String
  traceId           String
  sha256            String           @db.Char(64)
  syncStatus        String
  syncedAt          DateTime?
  createdAt         DateTime         @default(now())
  rechargeOrder     RechargeOrder?   @relation(fields: [rechargeOrderId], references: [id])
  rechargeOrderId   String?
  withdrawalOrder   WithdrawalOrder? @relation(fields: [withdrawalOrderId], references: [id])
  withdrawalOrderId String?
  tradeOrder        TradeOrder?      @relation(fields: [tradeOrderId], references: [id])
  tradeOrderId      String?
  paymentOrder      PaymentOrder?    @relation(fields: [paymentOrderId], references: [id])
  paymentOrderId    String?

  @@index([referenceType, referenceId])
  @@index([traceId])
  @@index([traceId, createdAt])
}

model Notice {
  id          String       @id @default(cuid())
  title       String
  content     String
  status      NoticeStatus @default(DRAFT)
  sortOrder   Int          @default(0)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model NewsCache {
  id          String   @id @default(cuid())
  title       String
  summary     String
  source      String
  url         String?
  publishedAt DateTime?
  fetchedAt   DateTime @default(now())
  rawPayload  Json

  @@index([fetchedAt])
  @@index([publishedAt])
  @@index([source, fetchedAt])
}

model LeaderboardConfig {
  id          String          @id @default(cuid())
  scope       String          @unique @default("default")
  currentRule LeaderboardRule @default(GOLD_HOLDING_GRAMS)
  traceId     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model LeaderboardJob {
  id           String              @id @default(cuid())
  version      String              @unique
  rule         LeaderboardRule
  status       LeaderboardJobStatus @default(REBUILDING)
  traceId      String              @unique
  totalRows    Int                 @default(0)
  failedRows   Int                 @default(0)
  errorMessage String?
  startedAt    DateTime            @default(now())
  finishedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  snapshots    LeaderboardSnapshot[]

  @@index([status, updatedAt])
  @@index([rule, createdAt])
  @@index([updatedAt])
}

model LeaderboardSnapshot {
  id               String         @id @default(cuid())
  jobId            String
  rank             Int
  uid              String
  nickname         String
  goldHoldingGrams Decimal        @db.Decimal(18, 4)
  totalAsset       Decimal        @db.Decimal(18, 2)
  syncStatus       String
  updatedAt        DateTime       @default(now())
  createdAt        DateTime       @default(now())
  job              LeaderboardJob @relation(fields: [jobId], references: [id])

  @@unique([jobId, rank])
  @@unique([jobId, uid])
  @@index([rank])
  @@index([uid])
  @@index([updatedAt])
  @@index([syncStatus])
}

model RiskRuleConfig {
  id                         String             @id @default(cuid())
  scope                      String             @unique @default("default")
  withdrawInterceptEnabled   Boolean            @default(true)
  singleWithdrawalLimit      Decimal            @db.Decimal(18, 2)
  dailyWithdrawalLimit       Decimal            @db.Decimal(18, 2)
  abnormalTradeThreshold     Decimal            @db.Decimal(18, 2)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  blacklistItems             RiskBlacklistUid[]

  @@index([updatedAt])
}

model RiskBlacklistUid {
  id               String         @id @default(cuid())
  riskRuleConfigId String
  uid              String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  riskRuleConfig   RiskRuleConfig @relation(fields: [riskRuleConfigId], references: [id])

  @@unique([riskRuleConfigId, uid])
  @@index([uid])
  @@index([updatedAt])
}

model OperationIdempotency {
  id              String                     @id @default(cuid())
  key             String                     @unique
  scope           String
  requestHash     String                     @db.Char(64)
  responsePayload Json?
  status          OperationIdempotencyStatus @default(PENDING)
  traceId         String
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([scope, status, updatedAt])
  @@index([traceId])
}

model ReportTemplate {
  id                  String               @id @default(cuid())
  name                String
  reportType          String
  filters             Json
  defaultFormat       ReportArtifactFormat @default(CSV)
  createdByAdminUserId String?
  traceId             String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  jobs                ReportJob[]

  @@index([reportType, createdAt])
}

model ReportJob {
  id                  String               @id @default(cuid())
  reportType          String
  status              ReportJobStatus      @default(PENDING)
  filters             Json
  requestedFormat     ReportArtifactFormat @default(CSV)
  traceId             String               @unique
  templateId          String?
  createdByAdminUserId String?
  errorMessage        String?
  rowCount            Int                  @default(0)
  startedAt           DateTime?
  finishedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  template            ReportTemplate?      @relation(fields: [templateId], references: [id])
  artifacts           ReportArtifact[]

  @@index([status, createdAt])
  @@index([reportType, createdAt])
}

model ReportArtifact {
  id          String               @id @default(cuid())
  jobId       String
  format      ReportArtifactFormat
  fileName    String
  mimeType    String
  content     String
  rowCount    Int                  @default(0)
  traceId     String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  job         ReportJob            @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@index([traceId])
}

model SystemConfig {
  id          String   @id @default(cuid())
  configKey   String   @unique
  configValue Json
  updatedAt   DateTime @updatedAt
}
